{
  "name": "best-engineering-schools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts BestEngineeringSchools out/best-engineering-schools.mp4",
